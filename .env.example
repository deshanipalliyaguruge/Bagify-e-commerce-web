# ============================================================
# Bagify E-Commerce — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# This file IS safe to commit. Never put real secrets here.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Bagify

# --- Supabase Storage ---
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=bagify-products
