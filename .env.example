# ============================================================
# Bagify E-Commerce — Environment Variables
# ============================================================
# Copy this file to .env.local for local dev.
# Add all variables to Vercel Dashboard → Project → Settings → Environment Variables.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key — has RLS applied (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — BYPASSES RLS. Server-only. Never expose to the client.
# Add this to Vercel as an Environment Variable WITHOUT the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ───────────────────────────────────────────────────
# Full canonical URL — used for metadata, sitemap, and og:url
# Production: https://yourdomain.com (no trailing slash)
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Display name shown in title tags, footer, emails
NEXT_PUBLIC_APP_NAME=Bagify

# ── Supabase Storage ──────────────────────────────────────────────
# The storage bucket name for product images
# Create this bucket in: Supabase Dashboard → Storage → New bucket
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=bagify-products

# ── Cron security ─────────────────────────────────────────────────
# Random secret to authenticate the Vercel cron job revalidation endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ── Optional: Error Monitoring ────────────────────────────────────
# Sentry DSN for production error tracking (optional but recommended)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=bagify

# ── Optional: Email (order confirmations) ────────────────────────
# Resend API key for transactional emails
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=orders@yourdomain.com
